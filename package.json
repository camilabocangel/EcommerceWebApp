    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.2.0",
    "mysql2": "^3.6.5",
    "nodemon": "^3.1.9",
    "pg": "^8.21.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  }
