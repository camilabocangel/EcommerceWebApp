{
  "name": "ecommercewebapp",
  "version": "1.0.0",
  "main": "api.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "db:up": "docker compose up -d --wait",
    "db:schema": "docker exec -i ecommerce_postgres psql -U ecommerce_user -d ecommerce_transaccional -v ON_ERROR_STOP=1 -v cliente_pwd=cliente_local_dev -v vendedor_pwd=vendedor_local_dev -v admin_pwd=admin_local_dev < db/sql/schema.sql",
    "db:mongo": "node scripts/migrar_a_mongo.js",
    "db:seed": "node scripts/seed_postgres.js",
    "setup": "npm run db:up && npm run db:schema && npm run db:mongo && npm run db:seed",
    "demo": "node scripts/verificar_integracion.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joackagui/EcommerceWebApp.git"
  },
