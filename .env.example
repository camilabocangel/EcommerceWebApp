# ──────────────────────────────────────────────────────────────
# Plantilla de variables de entorno.
# Copia este archivo como `.env` y rellena con valores reales.
# El archivo `.env` NO debe versionarse (está en .gitignore).
# ──────────────────────────────────────────────────────────────

# ---- (Legado) MySQL / AWS RDS — ya no se usa, conservado como referencia ----
DB_HOST=your-db-host
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
DB_PORT=3306

# ---- PostgreSQL (datos transaccionales: clientes, pedidos, pagos, facturas) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=ecommerce_transaccional

# Clave simétrica para cifrar el token de tarjeta (pgcrypto / pgp_sym_encrypt)
PG_CRYPTO_KEY=changeme_crypto_key

# Contraseñas de los roles RBAC con los que se conecta la app
PG_ROLE_CLIENTE_PASSWORD=changeme_cliente
PG_ROLE_VENDEDOR_PASSWORD=changeme_vendedor
PG_ROLE_ADMIN_PASSWORD=changeme_admin

# Secreto para firmar los JWT de sesión
JWT_SECRET=changeme_jwt_secret

# ---- MongoDB (catálogo de productos con etiquetas) ----
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=ecommerce_user
MONGO_PASSWORD=changeme_mongo
MONGO_DB=ecommerce_multitienda
